---
import Layout from '../layouts/Layout.astro';
import { groups } from '../data/categories';
import { offers, disclaimer } from '../data/offers';
import CategoryCard from '../components/CategoryCard.astro';
import OfferCard from '../components/OfferCard.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
const featured = ['ameriabank-visa-student', 'ucom-level-up-2500', 'yerevan-student-transport'].map(slug => offers.find(o => o.slug === slug)!);
---
<Layout>
  <div class="container">
    <section class="home-hero">
      <span class="eyebrow eyebrow-line">A little more possibility.</span>
      <div class="hero-content"><div><h1>Student opportunities<br /><span>in Armenia.</span></h1><p class="hero-copy">Discover student discounts, financial benefits, internships, scholarships, and educational opportunities — all in one place.</p></div><aside class="hero-side"><span class="location"><Icon name="globe" size={14} /> Armenia, for students</span><p>Less time searching.<br />More room for what’s next.</p></aside></div>
      <Search /><p class="hero-footnote">Independent research. Clear conditions. Official sources.</p>
    </section>
    <section class="home-section" aria-labelledby="explore-heading">
      <div class="section-heading"><div><h2 class="section-title" id="explore-heading">Explore your possibilities.</h2><p>Everyday benefits. First steps. New directions.</p></div><span class="eyebrow">The directory</span></div>
      <div class="category-grid">{groups.map((group, index) => <CategoryCard title={group.title} description={group.description} icon={group.icon} href={`/${group.slug}/`} index={`0${index + 1}`} />)}</div>
      <div class="research-band"><Icon name="file" size={18} /><p><strong>Start with the research.</strong> Banking & finance, mobile & internet, and transportation are ready to explore.</p><a href="/discounts/">Browse student discounts <Icon name="right" size={14} /></a></div>
    </section>
    <section class="home-section" aria-labelledby="researched-heading">
      <div class="section-heading"><div><span class="eyebrow mb-2">From the research</span><h2 class="section-title" id="researched-heading">A few places to start.</h2></div><a class="text-link" href="/search/">View all offers <Icon name="right" size={15} /></a></div>
      <div class="offer-grid">{featured.map(offer => <OfferCard offer={offer} />)}</div><p class="section-note">Researched offers, with current terms to confirm. {disclaimer}</p>
    </section>
    <section class="editorial-note"><div><span class="eyebrow">Clarity comes first</span><h2>Useful information.<br />With the details that matter.</h2></div><div><p>We bring student opportunities into one place, with eligibility, costs, and official sources kept in view. When a detail is missing or an offer needs checking, we say so.</p><a href="/about/research/" class="text-link">How we handle research <Icon name="arrow" size={15} /></a></div></section>
  </div>
</Layout>
