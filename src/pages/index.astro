---
import Layout from '../layouts/Layout.astro';
import { categories, categoryPath } from '../data/categories';
import { offersInCategory } from '../data/offers';
import CategoryCard from '../components/CategoryCard.astro';
import Search from '../components/Search.astro';
---
<Layout>
  <div class="container">
    <section class="home-hero">
      <h1>Student discounts<br /><span>in Armenia</span></h1>
      <p class="hero-copy">Discover local and international offers available to students studying in Armenia.</p>
      <Search />
    </section>
    <section class="home-section" aria-labelledby="explore-heading">
      <div class="section-heading"><div><h2 class="section-title" id="explore-heading">Explore your possibilities.</h2><p>Everyday benefits. First steps. New directions.</p></div></div>
      <div class="category-grid home-categories">{categories.map(category => <CategoryCard {...category} href={categoryPath(category)} count={offersInCategory(category.slug).length} />)}</div>
    </section>
  </div>
</Layout>
