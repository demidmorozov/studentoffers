---
import type { Offer } from '../data/types';
import { offerPath } from '../data/types';
import { offers, disclaimer, formatDate } from '../data/offers';
import { categories, categoryPath } from '../data/categories';
import { resolvedRequirements } from '../lib/offer-data';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
interface Props { offer: Offer; }
const { offer } = Astro.props;
const category = categories.find(c => c.slug === offer.category)!;
const requirements = resolvedRequirements(offer, offers);
const parentCard = offers.find(card => card.id === requirements.bankCardId);
const labels = { cashback: 'Cashback', discount: 'Discount', 'free-product': 'Free product', 'paid-plan': 'Paid student plan', 'bank-card': 'Bank card', financing: 'Repayable financing' };
---
<Layout title={`${offer.provider} ${offer.name}`} description={offer.summary}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Discounts', href: '/discounts/' }, { label: category.title, href: categoryPath(category) }, { label: offer.name }]} />
    <header class="detail-hero">
      <div><span class="eyebrow">{offer.provider} / {labels[offer.benefitType]}</span><h1>{offer.name}</h1><p>{offer.summary}</p>
        <nav class="category-links" aria-label="Offer categories">{categories.filter(item => offer.categories.includes(item.slug as Offer['category'])).map(item => <a href={categoryPath(item)}>{item.title}</a>)}</nav>
      </div>
      <div class="detail-benefit"><strong>{offer.benefit}</strong><span>{offer.benefitLabel}</span></div>
    </header>
    <div class="detail-layout">
      <article>
        <section class="detail-section"><h2>At a glance</h2><dl class="fact-list"><div><dt>Benefit type</dt><dd>{labels[offer.benefitType]}</dd></div>{offer.price && <div><dt>Price</dt><dd>{offer.price.amount.toLocaleString('en-US')} {offer.price.currency}{offer.price.period && ` / ${offer.price.period}`}</dd></div>}{offer.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
        <section class="detail-section"><h2>Who is eligible?</h2>
          {parentCard && <p class="requirement-callout">Requires <a href={offerPath(parentCard)}>{parentCard.provider} {parentCard.name}</a>. The card’s shared eligibility and exclusions apply.</p>}
          <ul class="detail-list">{requirements.membership && <li>Requires {requirements.membership}.</li>}{requirements.university && <li>{requirements.university} required.</li>}{requirements.eligibility.map(item => <li>{item}</li>)}</ul>
          {!parentCard && <p class="small-note">No specific bank card is required for this offer. Other eligibility conditions still apply.</p>}
        </section>
        <section class="detail-section"><h2>Verification requirements</h2><ul class="detail-list">{requirements.verification.map(item => <li>{item}</li>)}</ul></section>
        {offer.steps?.length && <section class="detail-section"><h2>How to redeem or apply</h2><ol class="detail-list">{offer.steps.map(item => <li>{item}</li>)}</ol></section>}
        <section class="detail-section"><h2>Important exclusions and conditions</h2><ul class="detail-list">{requirements.exclusions.map(item => <li>{item}</li>)}</ul></section>
        {offer.expiresAt && <section class="detail-section"><h2>Offer expiry</h2><p>{formatDate(offer.expiresAt)}</p></section>}
        {offer.sections?.map(section => <section class="detail-section"><h2>{section.title}</h2><ul class="detail-list">{section.items.map(item => <li>{item}</li>)}</ul></section>)}
        <div class="notice"><Icon name="info" size={16} /><p>{disclaimer}</p></div>
        <a href={categoryPath(category)} class="text-link mt-7"><Icon name="back" size={16} />Back to {category.title}</a>
      </article>
      <aside class="detail-sidebar" aria-label="Official sources and verification">
        <section class="sidebar-box"><h2>Go to the source.</h2><a class="button button-dark" href={offer.sources[0].url} target="_blank" rel="noopener noreferrer">Visit official provider <Icon name="arrow" size={15} /><span class="sr-only"> (opens in a new tab)</span></a><ul class="source-links">{offer.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}<Icon name="external" size={12} /><span class="sr-only"> (opens in a new tab)</span></a></li>)}</ul><p>Applications and eligibility checks take place with the provider.</p></section>
        <section class="sidebar-box"><h2>Source verification</h2><dl class="meta-list"><dt>Last successfully checked</dt><dd>{formatDate(offer.sourceVerification.lastChecked)}</dd><dt>Expiry date</dt><dd>{formatDate(offer.expiresAt)}</dd></dl><p>{offer.sourceVerification.note}</p><p>A checked source does not mean every student qualifies. Review the eligibility requirements above.</p><a class="text-link mt-4" href="/about/research/">Our research policy <Icon name="arrow" size={13} /></a></section>
      </aside>
    </div>
  </div>
</Layout>
