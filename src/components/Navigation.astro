---
import { groups } from '../data/categories';
interface Props { mobile?: boolean; }
const { mobile = false } = Astro.props;
const path = Astro.url.pathname;
---
<nav aria-label={mobile ? 'Mobile navigation' : 'Main navigation'} class:list={['nav-links', { 'mobile-links': mobile }]}>
  {groups.map(group => <a href={`/${group.slug}/`} class:list={{ current: path.startsWith(`/${group.slug}/`) }} aria-current={path === `/${group.slug}/` ? 'page' : undefined}>{group.title}</a>)}
  <a href="/about/" class:list={{ current: path.startsWith('/about/') }} aria-current={path === '/about/' ? 'page' : undefined}>About</a>
</nav>
